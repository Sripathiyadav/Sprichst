OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Where downloaded Piper voices live (default: ~/.sprichst/voices)
# PIPER_VOICES_DIR=~/.sprichst/voices

# --- Hosted model (optional). Keys live ONLY here, never in the app. ---
# AI_PROVIDER=ollama            # or groq
# GROQ_API_KEY=                 # set on the server only; never commit a real key

# --- Access control: turn these on for any server reachable from the internet ---
# Require a valid Firebase ID token (the app sends one automatically).
# AUTH_REQUIRED=1
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Requests per minute per client before the server answers 429.
# RATE_LIMIT_PER_MINUTE=60
# Extra web origins allowed to call the server, comma separated.
# CORS_ORIGINS=https://your-app.example

# --- Load and reliability ---
# Model, transcription and speech jobs allowed at once; extra requests wait up
# to INFERENCE_WAIT_SECONDS, then get a 503 "busy".
# MAX_CONCURRENT_INFERENCE=4
# INFERENCE_WAIT_SECONDS=10
# A second provider to try when AI_PROVIDER is down (ollama or groq).
# AI_FALLBACK_PROVIDER=
# LOG_LEVEL=INFO
