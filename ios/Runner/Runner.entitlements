<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keychain access: Google sign-in and Firebase Auth keep the session in the
	     Keychain, and fail without a keychain group (notably on the simulator). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.sprichst.app</string>
	</array>
</dict>
</plist>
